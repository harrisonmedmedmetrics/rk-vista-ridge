# Optional. Defaults to RK Logistics' public contact inbox.
TOUR_REQUEST_EMAIL=info@rklogisticsgroup.com

# Optional. When configured, the API securely posts tour requests here.
TOUR_REQUEST_WEBHOOK_URL=
TOUR_REQUEST_WEBHOOK_SECRET=

# Launch protection. Keep review-mailto until a real receiver, owner, backup owner,
# and response SLA are configured and the end-to-end delivery test has passed.
TOUR_REQUEST_DELIVERY_MODE=review-mailto
TOUR_REQUEST_PRIMARY_OWNER=
TOUR_REQUEST_BACKUP_OWNER=
TOUR_REQUEST_RESPONSE_SLA_MINUTES=

# Public canonical URL for metadata/sitemap when a custom domain is attached.
# Keep indexing disabled for preview/review deployments. Set to true only after
# the approved production domain and page are live.
NEXT_PUBLIC_SITE_INDEXABLE=false
NEXT_PUBLIC_SITE_URL=https://rk-vista-ridge.vercel.app
